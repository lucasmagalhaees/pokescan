# Variáveis de ambiente (Vercel > Project > Settings > Environment Variables)
# Chave da API da Anthropic: habilita leitura de foto (time/oponente). Sem ela, o app funciona normalmente sem foto.
ANTHROPIC_API_KEY=
# (opcional) Código de acesso exigido nas leituras de foto, para ninguém gastar sua chave.
ACCESS_CODE=
# (opcional) Modelo de visão. Padrão: claude-haiku-5-5
ANTHROPIC_MODEL=
